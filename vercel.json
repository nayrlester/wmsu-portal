{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web-portal": {
      "root": "apps/web-portal",
      "framework": "vite",
      "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && pnpm --filter @wmsu/web-portal build",
      "outputDirectory": "dist"
    },
    "admin-web": {
      "root": "apps/admin-web",
      "framework": "vite",
      "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile",
