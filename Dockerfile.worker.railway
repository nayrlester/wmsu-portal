FROM node:22-alpine AS deps
WORKDIR /repo
RUN corepack enable
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/config/package.json packages/config/package.json
COPY apps/worker/package.json apps/worker/package.json
RUN pnpm install --frozen-lockfile --filter @wmsu/worker...

FROM node:22-alpine AS build
WORKDIR /repo
RUN corepack enable
COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/packages/config/node_modules ./packages/config/node_modules
COPY --from=deps /repo/apps/worker/node_modules ./apps/worker/node_modules
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/config packages/config
COPY apps/worker apps/worker
RUN pnpm --filter @wmsu/config build && pnpm --filter @wmsu/worker build

FROM node:22-alpine AS production
WORKDIR /repo
RUN addgroup -g 1001 -S wmsu && adduser -S wmsu -u 1001 -G wmsu
ENV NODE_ENV=production
COPY --from=build --chown=wmsu:wmsu /repo/apps/worker/dist ./dist
COPY --from=build --chown=wmsu:wmsu /repo/apps/worker/package.json ./package.json
COPY --from=build --chown=wmsu:wmsu /repo/node_modules ./node_modules
USER wmsu
CMD ["node", "dist/main.js"]
