{
  "name": "wmsu-platform",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev-preflight.mjs && node scripts/dev-parallel.mjs dev:identity dev:platform-services dev:platform-web dev:clients",
    "dev:api": "node scripts/dev-preflight.mjs && node scripts/dev-parallel.mjs dev:identity dev:platform-services",
    "dev:stop": "node scripts/dev-stop-ports.mjs",
    "dev:identity": "npm run dev:api --prefix ../wmsu-api",
    "dev:platform-services": "pnpm run --parallel --filter @wmsu/base-api --filter @wmsu/worker dev",
    "dev:platform-web": "pnpm run --parallel --filter @wmsu/web-portal --filter @wmsu/admin-web dev",
    "dev:clients": "pnpm run --parallel --filter @wmsu/enrollment-web --filter @wmsu/records-web --filter @wmsu/finance-web --filter @wmsu/library-web --filter @wmsu/inventory-web --filter @wmsu/document-web --filter @wmsu/library-opac-web --filter @wmsu/library-kiosk-web dev",
    "dev:base-api": "pnpm --filter @wmsu/base-api dev",
    "dev:worker": "pnpm --filter @wmsu/worker dev",
    "dev:web": "pnpm --filter @wmsu/web-portal dev",
    "dev:admin": "pnpm --filter @wmsu/admin-web dev",
    "absorb:modules": "node scripts/phase4/absorb-all-modules.mjs",
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter './apps/*' --filter './packages/*' test",
    "db:migrate": "pnpm --filter @wmsu/base-api db:migrate",
    "db:seed": "pnpm --filter @wmsu/base-api db:seed",
    "db:rollback": "pnpm --filter @wmsu/base-api db:rollback",
    "db:schemas": "psql \"$DATABASE_URL\" -f infrastructure/database/01_schemas.sql",
    "db:bootstrap": "node scripts/phase3/apply-bootstrap.mjs",
    "db:consolidate": "node scripts/phase3/consolidate.mjs",
    "db:restore-module": "node scripts/phase3/restore-module.mjs",
    "db:absorb-module": "node scripts/phase3/absorb-module-migrations.mjs",
    "db:cutover-module": "node scripts/phase3/cutover-module.mjs",
    "openapi:generate": "pnpm --filter @wmsu/base-api openapi:generate",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f infrastructure/docker/docker-compose.yml logs -f",
    "verify": "node scripts/verify-infra.mjs",
    "build:staging": "node scripts/deploy/build.mjs staging",
    "build:production": "node scripts/deploy/build.mjs production",
    "deploy:staging": "node scripts/deploy/prepare.mjs staging",
    "deploy:production": "node scripts/deploy/prepare.mjs production",
    "deploy:cloud:staging": "node scripts/deploy/cloud.mjs staging",
    "deploy:cloud:production": "node scripts/deploy/cloud.mjs production"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "playwright": "^1.64.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
