TZ=Asia/Manila
PORT=3500
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
APP_VERSION=0.0.1

DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=wmsu
DB_PASSWORD=wmsu_dev_change_me
DB_DATABASE=wmsu_cis

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
QUEUE_NAME=wmsu-cis-jobs

CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5180,http://127.0.0.1:5181,http://127.0.0.1:5182,http://127.0.0.1:5183,http://127.0.0.1:5184,http://127.0.0.1:5185,http://localhost:5173,http://localhost:5174

# Local MDM admin writes only — never commit real secrets
MDM_ADMIN_API_KEY=dev-mdm-admin-change-me

# M2M integration key for /api/v1/integration/* writes
SERVICE_API_KEY=dev-service-api-change-me

# Local file storage root for CIS file abstraction
FILE_STORAGE_ROOT=./tmp/storage

# Phase 1 — Common Platform identity façade (wmsu-api engine)
GATEWAY_IDENTITY_URL=http://127.0.0.1:3411

# Dual auth — accept local opaque tokens and Identity JWTs (SSO launcher)
AUTH_MODE=dual
PLATFORM_IDENTITY_URL=http://127.0.0.1:3411
PLATFORM_JWKS_URL=http://127.0.0.1:3411/.well-known/jwks.json
PLATFORM_JWT_ISSUER=http://localhost:3411
PLATFORM_JWT_AUDIENCE=enterprise
PLATFORM_AUTO_PROVISION=true
PLATFORM_DEFAULT_ORG_CODE=UNI

# Phase 2a — Enrollment / USiS façade (wmsu-enrollment engine)
GATEWAY_ENROLLMENT_URL=http://127.0.0.1:3340

# Phase 2b — Finance / UFMS in-process (base-api modules/finance)
GATEWAY_FINANCE_URL=http://127.0.0.1:3500
FINANCE_API_URL=http://127.0.0.1:3500
FINANCE_INTERNAL_PREFIX=/api/v1/finance/internal
FINANCE_MOCK=false
# Local only: skip UFMS cashier and mark payment verified on POST /enrollments/:id/verify-payment
USIS_DEV_PAYMENT_BYPASS=true

# Phase 2c — Records / TORMS façade (wmsu-records engine)
GATEWAY_RECORDS_URL=http://127.0.0.1:3345

# Phase 2d — Library / ULMIS (in-process on base-api :3500)
GATEWAY_LIBRARY_URL=http://127.0.0.1:3500/api/v1/library
LIBRARY_API_URL=http://127.0.0.1:3500/api/v1/library
DEFAULT_TENANT_SLUG=ulmis
INSTITUTION_NAME=University Library
ULMIS_RESET_ADMIN_PASSWORD=false
ULMIS_INTEGRATION_DRY_RUN=true
# ULMIS_CIS_DEFICIENCY_URL=
# ULMIS_UFMS_FINE_REFERRAL_URL=
# ULMIS_UFMS_PAYMENT_RECONCILE_URL=
# ULMIS_UFMS_PR_URL=

# Phase 2e — Documents / UDMS façade (wmsu-document engine)
GATEWAY_DOCUMENTS_URL=http://127.0.0.1:3343

# Phase 2f — Inventory / UIMS façade (wmsu-inventory engine)
GATEWAY_INVENTORY_URL=http://127.0.0.1:3344

# Phase 3a — object storage (local MinIO from infra:up)
S3_ENDPOINT=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=wmsu_minio
AWS_SECRET_ACCESS_KEY=wmsu_minio_change_me
AWS_REGION=us-east-1
MINIO_BUCKET_DOCUMENTS=wmsu-documents
MINIO_BUCKET_RECORDS=wmsu-records
# WMSU_APP_ROLE_PASSWORD=wmsu_dev_change_me

# EmailJS (https://www.emailjs.com/docs/rest-api/send/) — preferred over SMTP when set
# Template must include variables: to_email, to_name, subject, message (optional: reply_to, from_name)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
MAIL_FROM_NAME=WMSU CIS
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=noreply@example.edu

# Philippine SMS. PhilSMS is tried first; UniSMS is the fallback.
# PHILSMS_API_URL=https://dashboard.philsms.com/api/v3/
# PHILSMS_API_TOKEN=
# PHILSMS_SENDER_ID=
# UNISMS_API_URL=https://unismsapi.com/api
# UNISMS_API_TOKEN=
# UNISMS_SENDER_ID=

