# WMSU CIS worker — Railway variables (required)
# Service: cis-worker — link the SAME Postgres + Redis as cis-base-api

NODE_ENV=production

DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
QUEUE_NAME=wmsu-cis-jobs

# Do NOT use 127.0.0.1:5433 or 127.0.0.1:6380 on Railway — those are local Docker only.
