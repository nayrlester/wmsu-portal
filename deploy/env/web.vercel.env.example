# Vercel — one project per app (Root Directory = apps/<name>)
# Vercel → Settings → Environment Variables → Production (+ Preview if needed)
# Redeploy after any VITE_* change (baked in at build time).
#
# Replace placeholders:
#   BASE_API   = Railway cis-base-api public URL (no trailing slash)
#   PORTAL     = https://wmsu-portal.vercel.app
#   Each *WEB*  = that app’s Vercel production URL (after you create the project)

# =============================================================================
# Shared (Railway Base API — set on cis-base-api service, not Vercel)
# =============================================================================
# CORS_ORIGINS=<PORTAL>,<ADMIN>,<USIS>,... (all Vercel origins, comma-separated)
# MDM_ADMIN_API_KEY / SERVICE_API_KEY must match admin-web VITE_* keys below

# =============================================================================
# 1) web-portal  —  Root: apps/web-portal  —  wmsu-portal.vercel.app
# =============================================================================
VITE_API_URL=https://wmsubase-api-production.up.railway.app
VITE_API_BASE_URL=https://wmsubase-api-production.up.railway.app
VITE_APP_ENV=production

# =============================================================================
# 2) admin-web  —  Root: apps/admin-web
# =============================================================================
VITE_API_BASE_URL=https://wmsubase-api-production.up.railway.app
VITE_MDM_ADMIN_KEY=<same as Railway MDM_ADMIN_API_KEY on cis-base-api>
VITE_SERVICE_API_KEY=<same as Railway SERVICE_API_KEY on cis-base-api>

# =============================================================================
# 3) enrollment-web (USIS)  —  Root: apps/enrollment-web
# =============================================================================
VITE_API_URL=https://wmsubase-api-production.up.railway.app/api/v1/enrollment
VITE_PLATFORM_IDENTITY_URL=https://wmsubase-api-production.up.railway.app
VITE_PORTAL_URL=https://wmsu-portal.vercel.app

# =============================================================================
# 4) records-web (TORMS)  —  Root: apps/records-web
# =============================================================================
VITE_API_URL=https://wmsubase-api-production.up.railway.app/api/v1/records
VITE_PLATFORM_IDENTITY_URL=https://wmsubase-api-production.up.railway.app
VITE_PORTAL_URL=https://wmsu-portal.vercel.app

# =============================================================================
# 5) finance-web (UFMS)  —  Root: apps/finance-web
# =============================================================================
VITE_API_URL=https://wmsubase-api-production.up.railway.app/api/v1/finance
VITE_PLATFORM_IDENTITY_URL=https://wmsubase-api-production.up.railway.app
VITE_PORTAL_URL=https://wmsu-portal.vercel.app

# =============================================================================
# 6) inventory-web (UIMS)  —  Root: apps/inventory-web
# =============================================================================
VITE_API_URL=https://wmsubase-api-production.up.railway.app/api/v1/inventory
VITE_PLATFORM_IDENTITY_URL=https://wmsubase-api-production.up.railway.app
VITE_PORTAL_URL=https://wmsu-portal.vercel.app

# =============================================================================
# 7) document-web (UDMS)  —  Root: apps/document-web
# =============================================================================
VITE_API_URL=https://wmsubase-api-production.up.railway.app/api/v1/documents
VITE_API_BASE_URL=https://wmsubase-api-production.up.railway.app/api/v1/documents
VITE_PLATFORM_IDENTITY_URL=https://wmsubase-api-production.up.railway.app
VITE_PORTAL_URL=https://wmsu-portal.vercel.app
VITE_APP_ENV=production
VITE_CDN_URL=
VITE_ONLYOFFICE_ENABLED=false

# =============================================================================
# 8) library-web (ULMIS staff)  —  Root: apps/library-web
# =============================================================================
VITE_API_URL=https://wmsubase-api-production.up.railway.app/api/v1/library
VITE_PLATFORM_IDENTITY_URL=https://wmsubase-api-production.up.railway.app
VITE_PORTAL_URL=https://wmsu-portal.vercel.app
VITE_DEPLOYMENT_MODE=university
VITE_APP_NAME=University Library
VITE_DEFAULT_TENANT_SLUG=ulmis
VITE_ALLOW_PUBLIC_REGISTER=false
VITE_OPAC_URL=https://<cis-opac>.vercel.app
VITE_KIOSK_URL=https://<cis-kiosk>.vercel.app

# =============================================================================
# 9) library-opac-web  —  Root: apps/library-opac-web
# =============================================================================
VITE_API_URL=https://wmsubase-api-production.up.railway.app/api/v1/library
VITE_DEFAULT_TENANT_SLUG=ulmis
VITE_APP_NAME=University Library OPAC
VITE_PORTAL_URL=https://wmsu-portal.vercel.app

# =============================================================================
# 10) library-kiosk-web  —  Root: apps/library-kiosk-web
# =============================================================================
VITE_API_URL=https://wmsubase-api-production.up.railway.app/api/v1/library
VITE_DEFAULT_TENANT_SLUG=ulmis
VITE_APP_NAME=University Library Kiosk
VITE_PORTAL_URL=https://wmsu-portal.vercel.app

# =============================================================================
# Identity API (wmsu-api on Railway) — NOT on Vercel; set platform launch URLs
# =============================================================================
# Each platform row needs launchUrl = https://<that-app>.vercel.app
# SSO callback: https://<that-app>.vercel.app/sso/callback
# CORS_ORIGIN must include every Vercel origin + PORTAL
# See wmsu-api/deploy/env/railway.api.env.example
