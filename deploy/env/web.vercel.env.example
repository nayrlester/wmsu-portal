# Vercel — per SPA project (Root Directory = apps/<name>)
# Set in Vercel → Settings → Environment Variables (Production + Preview).
# Redeploy after changing any VITE_* (compile-time).

# --- Portal (apps/web-portal) ---
VITE_API_URL=https://cis-base-api-production.up.railway.app
VITE_APP_ENV=production

# --- Admin (apps/admin-web) ---
# VITE_API_URL=https://cis-base-api-production.up.railway.app

# --- Domain clients (path suffix required) ---
# enrollment-web:
#   VITE_API_URL=https://cis-base-api-production.up.railway.app/api/v1/enrollment
#   VITE_PLATFORM_IDENTITY_URL=https://cis-base-api-production.up.railway.app
# records-web:
#   VITE_API_URL=https://cis-base-api-production.up.railway.app/api/v1/records
# finance-web:
#   VITE_API_URL=https://cis-base-api-production.up.railway.app/api/v1/finance
# library-web / opac / kiosk:
#   VITE_API_URL=https://cis-base-api-production.up.railway.app/api/v1/library
# inventory-web:
#   VITE_API_URL=https://cis-base-api-production.up.railway.app/api/v1/inventory
# document-web:
#   VITE_API_URL=https://cis-base-api-production.up.railway.app/api/v1/documents

# Identity SSO callback URLs → set on Identity API (../wmsu-api deploy/env/railway.api.env.example)
