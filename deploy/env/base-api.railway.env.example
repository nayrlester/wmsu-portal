# WMSU CIS Base API — Railway variables (example)
# Service: cis-base-api | Config: deploy/railway/base-api.toml

NODE_ENV=production
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=generate_with_node_ace_generate_key
APP_VERSION=0.0.1

APP_URL=https://cis-base-api-production.up.railway.app

DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
QUEUE_NAME=wmsu-cis-jobs

CORS_ORIGINS=https://cis-portal.vercel.app,https://cis-admin.vercel.app,https://cis-usis.vercel.app,https://cis-torms.vercel.app,https://cis-ufms.vercel.app,https://cis-ulmis.vercel.app,https://cis-opac.vercel.app,https://cis-kiosk.vercel.app,https://cis-uims.vercel.app,https://cis-udms.vercel.app

MDM_ADMIN_API_KEY=
SERVICE_API_KEY=

GATEWAY_IDENTITY_URL=https://identity-service-api.example.com
PLATFORM_IDENTITY_URL=https://identity-service-api.example.com
PLATFORM_JWKS_URL=https://identity-service-api.example.com/.well-known/jwks.json
PLATFORM_JWT_ISSUER=https://identity-service-api.example.com
PLATFORM_JWT_AUDIENCE=enterprise
AUTH_MODE=dual
PLATFORM_AUTO_PROVISION=true
PLATFORM_DEFAULT_ORG_CODE=UNI

S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
MINIO_BUCKET_DOCUMENTS=wmsu-documents
MINIO_BUCKET_RECORDS=wmsu-records

FILE_STORAGE_ROOT=/tmp/storage
